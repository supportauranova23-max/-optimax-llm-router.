<script>
let ROLE = 'me';

function tab(id, b) {
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav button').forEach(x => x.classList.remove('active'));
  const el = document.getElementById(id);
  if (el) el.classList.add('active');
  if (b) b.classList.add('active');
}

async function switchRole(r) {
  const k = document.getElementById('key').value.trim();
  try {
    const res = await fetch(r === 'org' ? '/api/dashboard/org' : '/api/dashboard/me', {
      headers: { 'Authorization': 'Bearer ' + k }
    });
    const d = await res.json();
    if (res.status === 403 && d.upgrade_required) {
      document.getElementById('upModal').style.display = 'flex';
      return;
    }
    ROLE = r;
    document.getElementById('sw-me').classList.toggle('active', r === 'me');
    document.getElementById('sw-org').classList.toggle('active', r === 'org');
    if (r === 'me') {
      document.getElementById('k1-lbl').textContent = 'Personal Savings';
      document.getElementById('k1-val').textContent = '$' + (d.saved_usd || 0);
      document.getElementById('k2-lbl').textContent = 'Tokens Routed';
      document.getElementById('k2-val').textContent = d.tokens_routed || 0;
      document.getElementById('k3-lbl').textContent = 'PII Masked';
      document.getElementById('k3-val').textContent = d.pii_masked || 0;
    } else {
      document.getElementById('k1-lbl').textContent = 'Org Savings (' + (d.workspace || 'Team') + ')';
      document.getElementById('k1-val').textContent = '$' + (d.org_saved_usd || 0);
      document.getElementById('k2-lbl').textContent = 'Active IoT Devices';
      document.getElementById('k2-val').textContent = (d.active_iot_devices || 0) + ' (' + (d.cache_hit_pct || 0) + '% Cache)';
      document.getElementById('k3-lbl').textContent = 'Rogue Loops Blocked';
      document.getElementById('k3-val').textContent = d.rogue_loops_blocked || 0;
    }
    document.getElementById('logFeed').innerHTML = (d.logs || [])
      .map(l => `<div style='padding:8px;border-bottom:1px solid #1e293b'><b>[${l.device_id}]</b> ${l.model} • ${l.tokens} tok • ${l.latency}ms • <span style='color:#00f5d4'>Saved $${l.saved}</span></div>`)
      .join('');
  } catch (err) {
    document.getElementById('out').textContent = 'Dashboard Load Error: ' + err.message;
  }
}

function refreshDash() { switchRole(ROLE); }

async function genIoTKey() {
  const box = document.getElementById('iotKeyBox');
  box.textContent = 'Generating IoT Fleet Key...';
  try {
    const r = await fetch('/api/keys/iot', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + document.getElementById('key').value.trim() }
    });
    const d = await r.json();
    box.textContent = r.ok ? ('New IoT Fleet Key (60 RPM Limit): ' + d.api_key) : JSON.stringify(d);
  } catch (err) {
    box.textContent = 'Error: ' + err.message;
  }
}

async function runIDE() {
  const o = document.getElementById('out');
  o.textContent = 'Routing via Zero-Retention Edge...';
  try {
    const r = await fetch('/v1/route', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + document.getElementById('key').value.trim()
      },
      body: JSON.stringify({ prompt: document.getElementById('prm').value })
    });
    o.textContent = JSON.stringify(await r.json(), null, 2);
    refreshDash();
  } catch (err) {
    o.textContent = 'Route Error: ' + err.message;
  }
}

switchRole('me');
</script>
</body>
</html>
