  function showIDE(t){IDE=t;const k=kVal(),u='https://onrender.com c={cursor:`{\n  "openai.apiKey": "${k}",\n  "openai.baseUrl": "${u}"\n}`,cline:`{\n  "apiProvider": "openai",\n  "openAiBaseUrl": "${u}",\n  "openAiApiKey": "${k}"\n}`,windsurf:`{\n  "windsurf.customApiUrl": "${u}",\n  "windsurf.apiKey": "${k}"\n}`,python:`from openai import OpenAI\nclient = OpenAI(api_key="${k}", base_url="${u}")`};const b=document.getElementById('ideBox');if(b)b.textContent=c[IDE]}
  async function setRole(r){try{const res=await fetch(r==='org'?'/api/dashboard/org':'/api/dashboard/me',{headers:{'Authorization':'Bearer '+kVal()}});const d=await res.json();if(res.status===403&&d.upgrade_required){const m=document.getElementById('upModal');if(m)m.style.display='flex';return}ROLE=r;document.getElementById('sw-me')?.classList.toggle('active',r==='me');document.getElementById('sw-org')?.classList.toggle('active',r==='org');document.getElementById('l1').textContent=r==='me'?'Personal Savings':'Org Savings';document.getElementById('v1').textContent='$'+(r==='me'?(d.saved_usd||0):(d.org_saved_usd||0));document.getElementById('l2').textContent=r==='me'?'Tokens Routed':'Active IoT Devices';document.getElementById('v2').textContent=r==='me'?(d.tokens_routed||0):(d.active_iot_devices||0);document.getElementById('l3').textContent=r==='me'?'PII Masked':'Loops Blocked';document.getElementById('v3').textContent=r==='me'?(d.pii_masked||0):(d.rogue_loops_blocked||0);const lb=document.getElementById('logBox');if(lb)lb.innerHTML=(d.logs||[]).map(l=>`<div style="padding:6px;border-bottom:1px solid #1e293b">[${l.device_id}] ${l.model} • Saved $${l.saved}</div>`).join('')||'No traces yet.'}catch(e){}}
  document.addEventListener('click',async(e)=>{
    const b=e.target.closest('[data-act]');if(!b)return;const a=b.dataset.act;
    if(a==='tab'){document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));document.getElementById(b.dataset.t)?.classList.add('active');b.classList.add('active')}
    else if(a==='mode'){MODE=b.dataset.m;document.querySelectorAll('.pre').forEach(x=>x.classList.remove('active'));b.classList.add('active')}
    else if(a==='ide')showIDE(b.dataset.i);
    else if(a==='copy-ide'){navigator.clipboard.writeText(document.getElementById('ideBox')?.textContent||'');b.textContent='✓ Copied!';setTimeout(()=>b.textContent='📋 Copy Config',1500)}
    else if(a==='copy-key'){navigator.clipboard.writeText(document.getElementById('trialBox')?.value||'');b.textContent='✓ Copied!';setTimeout(()=>b.textContent='📋 Copy Key',1500)}
    else if(a==='role')await setRole(b.dataset.r);
    else if(a==='close')document.getElementById('upModal').style.display='none';
    else if(a==='iot'){const r=await fetch('/api/keys/iot',{method:'POST',headers:{'Authorization':'Bearer '+kVal()}});const d=await r.json();document.getElementById('iotBox').textContent=r.ok?'Created: '+d.api_key:JSON.stringify(d)}
    else if(a==='route'){const o=document.getElementById('out');o.textContent='Routing ('+MODE+')...';const r=await fetch('/v1/route',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+kVal()},body:JSON.stringify({prompt:document.getElementById('prm')?.value||'',preset:MODE})});o.textContent=JSON.stringify(await r.json(),null,2);await setRole(ROLE)}
  });
  document.getElementById('key')?.addEventListener('input',()=>{const tb=document.getElementById('trialBox');if(tb)tb.value=kVal();showIDE(IDE);setRole(ROLE)});
  showIDE('cursor');setRole('me');
});
</script>
</body>
