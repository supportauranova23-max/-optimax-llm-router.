<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>OptiMax Quantum | Neural & Edge AI Gateway</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#030712;color:#f1f5f9;display:flex;min-height:100vh;position:relative}
.glow-bg,.glow-bg::before,.glow-bg::after,.glass-overlay,.grid-bg{position:fixed;inset:0;background:radial-gradient(circle at 15% 15%,rgba(56,189,248,0.12),transparent 40%),radial-gradient(circle at 85% 80%,rgba(0,245,212,0.1),transparent 40%);pointer-events:none !important;z-index:0}
.side,.main,.modal{position:relative;z-index:5}
button,.btn,.pre-btn,.nav button,.switcher button,a{position:relative;z-index:10;cursor:pointer !important}
.side{width:235px;background:#0a0f1c;border-right:1px solid #1e293b;padding:18px 12px;display:flex;flex-direction:column;justify-content:space-between}
.logo{font-weight:800;font-size:16px;color:#00f5d4;padding-bottom:14px;border-bottom:1px solid #1e293b}
.nav{margin-top:14px;display:flex;flex-direction:column;gap:5px}
.nav button{background:none;border:none;color:#94a3b8;padding:10px 12px;border-radius:8px;text-align:left;font-size:13.5px;font-weight:600}
.nav button.active,.nav button:hover{background:#1e293b;color:#38bdf8}
.main{flex:1;padding:20px;max-width:1080px;margin:0 auto;width:100%}
.topbar{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;background:#0a0f1c;border:1px solid #1e293b;padding:10px 16px;border-radius:10px;margin-bottom:16px}
.switcher{display:inline-flex;background:#030712;border:1px solid #334155;border-radius:20px;padding:3px}
.switcher button{background:none;border:none;color:#94a3b8;padding:6px 14px;border-radius:16px;font-size:12.5px;font-weight:700}
.switcher button.active{background:linear-gradient(90deg,#00f5d4,#0284c7);color:#022c22}
.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px}
.kpi{background:#0f172a;border:1px solid #1e293b;padding:14px;border-radius:10px}
.kpi small{color:#94a3b8;font-size:11px;text-transform:uppercase}.kpi div{font-size:20px;font-weight:800;margin-top:4px;color:#00f5d4}
.panel{display:none;background:#0f172a;border:1px solid #1e293b;border-radius:12px;padding:18px}.panel.active{display:block}
.presets{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}
.pre-btn{background:#030712;border:1px solid #334155;color:#cbd5e1;padding:10px;border-radius:8px;text-align:left;font-size:12px}
.pre-btn.active{border-color:#00f5d4;background:rgba(0,245,212,0.12);color:#fff}
input,textarea{width:100%;padding:10px;border-radius:8px;border:1px solid #334155;background:#030712;color:#fff;margin:6px 0 10px;font-size:13px;position:relative;z-index:10}
.btn{background:#0284c7;color:#fff;border:none;padding:9px 15px;border-radius:8px;font-weight:700;text-decoration:none;display:inline-block;font-size:12.5px}
.cta{background:linear-gradient(90deg,#00f5d4,#10b981);color:#022c22;font-weight:800}
pre{background:#020617;border:1px solid #1e293b;padding:12px;border-radius:8px;color:#00f5d4;white-space:pre-wrap;font-size:12px;margin:8px 0}
.modal{display:none;position:fixed;inset:0;background:rgba(2,6,23,0.85);align-items:center;justify-content:center;z-index:50;padding:16px}
.modal-box{background:#0f172a;border:1px solid #00f5d4;border-radius:14px;padding:24px;max-width:440px;width:100%;text-align:center}
@media(max-width:768px){body{flex-direction:column}.side{width:100%}.nav{flex-direction:row;overflow-x:auto}.kpis,.presets{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="glow-bg"></div>
<div class="side">
  <div>
    <div class="logo">⚡ OPTIMAX QUANTUM</div>
    <div class="nav">
      <button data-action="tab" data-target="play" class="active">⚡ Neural Playground</button>
      <button data-action="tab" data-target="ide">🔌 Connect IDE</button>
      <button data-action="tab" data-target="iot">📡 Edge & IoT Fleet</button>
      <button data-action="tab" data-target="logs">📊 Route Trace Log</button>
      <button data-action="tab" data-target="keys">🔑 14-Day Trial Key</button>
    </div>
  </div>
  <a href="/upgrade" target="_blank" class="btn cta" style="text-align:center">Upgrade Enterprise</a>
</div>
<div class="main">
  <div class="topbar">
    <span style="color:#00f5d4;font-size:12px;font-weight:700">🛡️ Zero-Data-Retention: ACTIVE</span>
    <div class="switcher">
      <button id="sw-me" data-action="role" data-role="me" class="active">Personal View</button>
      <button id="sw-org" data-action="role" data-role="org">Team Admin</button>
    </div>
    <input id="key" value="optx_free_trial_user" style="width:210px;margin:0;padding:6px 10px;font-size:12px" placeholder="API Key">
  </div>
  <div class="kpis">
    <div class="kpi"><small id="k1-lbl">Personal Savings</small><div id="k1-val">$0.00</div></div>
    <div class="kpi"><small id="k2-lbl">Tokens Routed</small><div id="k2-val" style="color:#38bdf8">0</div></div>
    <div class="kpi"><small id="k3-lbl">PII Masked</small><div id="k3-val" style="color:#fff">0</div></div>
  </div>
