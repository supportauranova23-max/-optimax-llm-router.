<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OptiMax AI Router & Gateway</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background: #0d1117; color: #c9d1d9; margin: 0; padding: 30px; }
        .container { max-width: 850px; margin: 0 auto; background: #161b22; padding: 25px; border-radius: 8px; border: 1px solid #30363d; }
        .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #30363d; padding-bottom: 15px; }
        .logo { width: 40px; height: 40px; background: linear-gradient(135deg, #1f6feb, #3fb950); border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-weight: bold; color: #fff; margin-right: 10px; }
        h1 { color: #58a6ff; margin: 0; display: inline; font-size: 22px; }
        .badge { padding: 5px 12px; background: rgba(63, 185, 80, 0.15); color: #3fb950; border-radius: 20px; font-size: 13px; }
        .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin: 20px 0; }
        .box { background: #21262d; padding: 15px; border-radius: 6px; border: 1px solid #30363d; text-align: center; }
        .val { font-size: 20px; font-weight: bold; color: #3fb950; margin-top: 5px; }
        .card { background: #21262d; padding: 20px; border-radius: 6px; border: 1px solid #30363d; margin-top: 15px; }
        .btn { display: inline-block; background: #238636; color: #fff; padding: 10px 20px; text-decoration: none; border-radius: 6px; font-weight: bold; border: none; cursor: pointer; font-size: 14px; }
        .blue { background: #1f6feb; }
        input { padding: 10px; border-radius: 6px; border: 1px solid #30363d; background: #0d1117; color: #fff; width: 35%; margin-right: 8px; }
        pre { background: #0d1117; padding: 12px; border-radius: 6px; border: 1px solid #30363d; color: #79c0ff; overflow-x: auto; font-size: 12px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div><span class="logo">OX</span><h1>OptiMax AI Router & Gateway</h1></div>
            <span class="badge">● Postgres & 14-Day Trial Live</span>
        </div>
        <div class="grid">
            <div class="box"><div>Trial Period</div><div class="val">14 Days</div></div>
            <div class="box"><div>AI Models</div><div class="val">GPT-4o / Gemini</div></div>
            <div class="box"><div>Billing</div><div class="val" style="color: #58a6ff;">Lemon + Payoneer</div></div>
        </div>
        <div class="card">
            <h3>1. Start Your Free 2-Week Trial</h3>
            <form action="/start-trial" method="post">
                <input type="text" name="name" placeholder="Your Name" required>
                <input type="email" name="email" placeholder="Work Email" required>
                <button type="submit" class="btn blue">Get 14-Day Trial Key</button>
            </form>
        </div>
        <div class="card">
            <h3>2. Developer API Endpoint</h3>
            <pre>POST https://onrender.com | Header: Authorization: Bearer YOUR_KEY</pre>
        </div>
        <div class="card" style="text-align: center;">
            <h3>3. Test & Upgrade</h3>
            <a class="btn blue" href="/docs" style="margin-right: 10px;">Open API Playground</a>
            <a class="btn" href="/upgrade">Upgrade Account ($49/mo)</a>
        </div>
    </div>
</body>
</html>
